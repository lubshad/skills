#!/bin/bash

set -euo pipefail

# Dual-environment reference. Existing production-only apps keep their contract
# until explicitly migrated together with their workflows and configuration.
target=development
case "${1:-}" in
	"") ;;
	--prod) target=production ;;
	-h|--help) echo "Usage: ./deploy [--prod] (default: development)"; exit 0 ;;
	*) echo "Usage: ./deploy [--prod]" >&2; exit 1 ;;
esac
[ "$#" -le 1 ] || { echo "Usage: ./deploy [--prod]" >&2; exit 1; }
backup="${target}-backup"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null)"; then
	echo "This script must be run inside a git repository." >&2
	exit 1
fi

cd "$REPO_ROOT"

if [ -n "$(git status --porcelain)" ]; then
	echo "Commit or stash all changes before promoting to $target." >&2
	exit 1
fi

current_branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$current_branch" = "HEAD" ]; then
	echo "Detached HEAD is not supported for $target promotion." >&2
	exit 1
fi

if [[ "$current_branch" = production || "$current_branch" = production-backup || "$current_branch" = development || "$current_branch" = development-backup ]]; then
	echo "Promote from a development or release branch, not $current_branch." >&2
	exit 1
fi

git fetch origin --prune

if ! git show-ref --verify --quiet "refs/remotes/origin/$target"; then
	echo "Remote branch origin/$target was not found." >&2
	echo "Initialize $target and $backup from the intended baseline first." >&2
	exit 1
fi

target_commit="$(git rev-parse "refs/remotes/origin/$target")"
backup_commit="$(git rev-parse --verify "refs/remotes/origin/$backup" 2>/dev/null || :)"
source_commit="$(git rev-parse HEAD)"
echo "Backing up origin/$target to $backup..."
git push "--force-with-lease=refs/heads/$backup:$backup_commit" origin \
	"$target_commit:refs/heads/$backup"
git fetch origin "$backup"
git branch -f "$backup" "origin/$backup"

echo "Promoting $current_branch to $target..."
git push "--force-with-lease=refs/heads/$target:$target_commit" origin "$source_commit:refs/heads/$target"
git fetch origin "$target"
git branch -f "$target" "origin/$target"

echo "$target promotion completed. GitHub Actions will deploy the $target branch."
